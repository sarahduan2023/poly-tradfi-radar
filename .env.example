# ============================================================================
# Polymarket CLOB Configuration
# ============================================================================
POLY_CLOB_HOST=https://clob.polymarket.com

# Target Polymarket Outcome Token ID (use `python poly_tradfi_monitor.py --discover "Fed"` to search)
POLY_TOKEN_ID=113379839734351069617987084078322474966003108854908079701423911002443710490196
POLY_EVENT_LABEL="Will 1 Fed rate cut happen in 2026 (Yes)"

# ============================================================================
# Traditional Finance (TradFi) Symbols (via Yahoo Finance)
# ============================================================================
EQUITY_TICKER=QQQ
YIELD_TICKER=^TNX

# ============================================================================
# Macro Divergence Engine Parameters
# ============================================================================
WINDOW_SIZE=15                      # Rolling snapshot window size
POLL_INTERVAL_SEC=60                # Interval between ticks in seconds
PROB_DELTA_THRESHOLD=0.015          # Probability delta trigger threshold (0.015 = 1.5%)
EQUITY_PCT_THRESHOLD=0.25           # Equity % move trigger threshold (0.25 = 0.25%)
MAX_SPREAD_THRESHOLD=0.03           # Max CLOB spread allowed (0.03 = 3 cents; prevents illiquid spikes)
ALERT_COOLDOWN_SEC=900              # Cooldown between duplicate alerts in seconds (900s = 15m)

# ============================================================================
# Webhook Alert Credentials (Optional)
# ============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# ============================================================================
# Proxy Configuration (Optional, e.g., local proxy for Telegram API)
# ============================================================================
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
